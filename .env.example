# ─────────────────────────────────────────────────────────────
# MAISON LISA — environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Core
APP_URL=http://localhost:3000
DATABASE_URL=postgres://maison:maison_dev@localhost:5432/maison_lisa
# 32+ random characters (HMAC for signed links, guest cart tokens). `openssl rand -hex 32`
SESSION_SECRET=
# 32-byte key, base64 (AES-256-GCM for MFA secrets). `openssl rand -base64 32`
APP_ENCRYPTION_KEY=
# Default locale for "/" redirects and fallbacks (de, en, fr, es, it, nl, pl, pt)
NEXT_PUBLIC_DEFAULT_LOCALE=de
# Branding (optional overrides — defaults live in src/config/brand.ts)
# NEXT_PUBLIC_BRAND_NAME=MAISON LISA
# NEXT_PUBLIC_CREATOR_NAME=Lisa
# NEXT_PUBLIC_SUPPORT_EMAIL=concierge@example.com
# NEXT_PUBLIC_BRAND_MONOGRAM=ML

# Seller / legal entity — shown in the Legal Notice and on receipts.
# Until LEGAL_ENTITY_NAME is set, legal pages and receipts show a visible placeholder warning.
LEGAL_ENTITY_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_VAT_ID=
LEGAL_REGISTER=
LEGAL_YOUTH_PROTECTION_OFFICER=

# Mail — "outbox" stores mails in the database (viewable at /<locale>/dev/mailbox in development)
MAIL_TRANSPORT=outbox
MAIL_FROM="MAISON LISA <concierge@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Where Lisa receives "new message / new order" alerts (no chat content is included)
ADMIN_NOTIFY_EMAIL=

# Private storage — "local" writes outside /public; "s3" works with AWS S3, Cloudflare R2, Supabase Storage (S3 API), MinIO
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Identity & age verification — "dev" is a labelled simulator (refused in production); "veriff" is the real adapter
VERIFICATION_PROVIDER=dev
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFICATION_VALIDITY_DAYS=365

# Payments — "dev" is a labelled simulator (refused in production); "verotel" is the FlexPay adapter
PAYMENT_PROVIDER=dev
VEROTEL_SHOP_ID=
VEROTEL_SIGNATURE_KEY=
VEROTEL_FLEXPAY_URL=https://secure.verotel.com/startorder

# Development simulators. MUST be false (or absent) in production.
ALLOW_DEV_SIMULATORS=true
DEV_WEBHOOK_SECRET=dev-webhook-secret-change-me-0123456789

# Operations
CRON_SECRET=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Development/test only: disables rate limiting (ignored when NODE_ENV=production).
# The e2e suite sets this for the server it starts, as it registers many accounts from one IP.
RATE_LIMIT_DISABLED=false

# Content security policy additions (space separated hosts), e.g. your S3/CDN host
CSP_EXTRA_IMG=
CSP_EXTRA_CONNECT=

# Seeding (development)
SEED_ADMIN_EMAIL=lisa@maison-lisa.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_CONTENT=true
